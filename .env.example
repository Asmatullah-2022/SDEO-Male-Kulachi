# Supabase project credentials
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. Never expose this to the browser
# or commit it to version control. Used only in src/app/api routes
# to create Headteacher auth accounts from the Admin panel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Official SDEO (Male) Kulachi WhatsApp number.
# Only used for individual messages (e.g. the admin's pending-schools
# reminder) — NOT for the report-sharing button, which targets a group.
# Format: country code + number, digits only, no "+" and no spaces.
# Example: 923001234567
NEXT_PUBLIC_OFFICIAL_WHATSAPP_NUMBER=923001234567

# TEMPORARY TESTING ONLY — a WhatsApp group invite link
# (https://chat.whatsapp.com/...) that the "Share Report" button opens
# directly, bypassing the normal pre-filled group-picker flow. Leave this
# UNSET in production: when unset, the button falls back to the normal
# behavior (message pre-filled, Headteacher picks the group themselves).
# Remove this variable once testing is complete.
NEXT_PUBLIC_OFFICIAL_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/HyHhzVt62D5A7BqPmgXDt4?s=cl&p=a&mlu=4&ilr=4
